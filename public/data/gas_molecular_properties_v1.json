      "outputFields": ["source isotherm points", "adsorption basis", "fit eligibility", "field provenance"],
      "missingWhenZh": "缺少单组分或成对等温线点",
      "queryFieldsZh": ["吸附剂名称", "吸附质气体", "温度", "压力", "DOI", "等温线 ID"],
      "outputFieldsZh": ["来源等温线点", "吸附基准", "拟合资格", "字段级溯源"]
    },
    {
      "id": "molecular-property-gap",
      "missingWhen": "gas size, polarity, quadrupole, or condensability context is unavailable",
      "targetSourceId": "nist-chemistry-webbook-srd69",
      "queryFields": ["gas formula", "CAS number", "common name"],
      "outputFields": ["molecular identity", "thermophysical context", "source citation"],
      "missingWhenZh": "缺少气体尺寸、极性、四极矩或可凝性语境",
      "queryFieldsZh": ["气体分子式", "CAS 号", "通用名称"],
      "outputFieldsZh": ["分子身份", "热物性语境", "来源引用"]
    },
    {
      "id": "breakthrough-gap",
      "missingWhen": "dynamic mixture validation is absent",
      "targetSourceId": "nist-adsorption-data-resources",
      "queryFields": ["DOI", "gas pair", "feed ratio", "bed condition", "flow rate"],
      "outputFields": ["breakthrough time", "dynamic capacity", "outlet concentration curve", "process boundary"],
      "missingWhenZh": "缺少动态混合气验证",

      "researchCases": [
        {
          "id": "boronenzyme",
          "heading": "把硼酸基放进蛋白质催化口袋",
          "organizationIds": [
            "rug"
          ],
          "authors": "Lars Longwitz、Reuben B. Leveson-Gower、Henriëtte J. Rozeboom 等",
          "paperTitle": "Boron catalysis in a designer enzyme",
          "journal": "Nature (2024)",
          "published": "2024",
          "doi": "10.1038/s41586-024-07391-3",
          "paperUrl": "https://doi.org/10.1038/s41586-024-07391-3",
          "paragraphs": [
            "格罗宁根大学团队用扩展遗传密码，将带硼酸基团的非天然氨基酸引入蛋白，并通过定向进化改善催化效率和立体选择性。催化基团与蛋白口袋各自承担一部分化学控制。",
            "这一实例把有机硼化学与酶工程连接起来。能催化一种新反应，是建立人工酶功能的起点；后续还要考察底物范围、稳定性和制备成本。"
          ],

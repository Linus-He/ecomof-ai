      "researchCases": [
        {
          "id": "steroid",
          "heading": "胆汁酸研究从主结构走向微生物修饰",
          "organizationIds": [
            "msu"
          ],
          "authors": "Douglas V. Guzior、Maxwell Okros、Madison Shivel 等",
          "paperTitle": "Bile salt hydrolase acyltransferase activity expands bile acid diversity",
          "journal": "Nature (2024)",
          "published": "2024",
          "doi": "10.1038/s41586-024-07017-8",
          "paperUrl": "https://doi.org/10.1038/s41586-024-07017-8",
          "paragraphs": [
            "密歇根州立大学团队发现，胆盐水解酶还具有酰基转移活性，可将氨基酸连接到胆汁酸上，从而扩展肠道中胆汁酸的化学多样性。不同菌株对氨基酸的使用也存在差异。",
            "认识甾体骨架之后，还必须区分它的具体修饰形式。相同母核上的连接基团可能改变溶解性、代谢和信号作用；研究不能将所有胆汁酸只合并成一个总量指标。"
          ],
          "sources": [

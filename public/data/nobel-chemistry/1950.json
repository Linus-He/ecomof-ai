  "reading": {
    "title": "双烯合成",
    "summary": "双烯合成。提供直接构建碳环且保留立体信息的反应。",
    "sections": [
      {
        "id": "background",
        "title": [
          "研究背景",
          "Background"
        ],
        "body": "复杂六元环怎样通过少量步骤构建，是有机合成的重要问题。"
      },
      {
        "id": "principle",
        "title": [
          "原理与机理",
          "Principles and mechanisms"
        ],
        "body": "共轭双烯与亲双烯体发生协同成环，通常形成两个新 σ 键。",
        "equation": "\\mathrm{diene+dienophile\\xrightarrow{[4+2]}cyclohexene\\ derivative}",
        "equationNote": "[4+2] 是参与 π 电子的计数；反应需合适构象，立体选择性依底物和条件而变。",
        "supplementalEquations": []
      },
      {
        "id": "uses",
        "title": [
          "应用",
          "Applications"
        ],
        "body": "用于环状天然产物、药物中间体与材料单体合成。"
      },
      {
        "id": "significance",
        "title": [
          "科学意义",
          "Significance"
        ],
        "body": "提供直接构建碳环且保留立体信息的反应。"
      },
      {
        "id": "development",
        "title": [
          "研究与产业进展",
          "Research and industrial progress"
        ],
        "body": "环加成让多个键在一次转化中建立。现代环系构筑发展出更多逐步路线，其机理与经典协同反应需要分别判断。"
      }
    ],

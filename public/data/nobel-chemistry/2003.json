      "researchCases": [
        {
          "id": "aquaporin",
          "heading": "水通道还受周围脂质膜调节",
          "organizationIds": [
            "uiuc"
          ],
          "authors": "Anh T. P. Nguyen、Austin T. Weigle、Diwakar Shukla",
          "paperTitle": "Functional regulation of aquaporin dynamics by lipid bilayer composition",
          "journal": "Nature Communications (2024)",
          "published": "2024",
          "doi": "10.1038/s41467-024-46027-y",
          "paperUrl": "https://doi.org/10.1038/s41467-024-46027-y",
          "paragraphs": [
            "伊利诺伊大学厄巴纳–香槟分校团队利用分子动力学模拟改变膜环境，比较水通道蛋白的结构、热力学、动力学和预测水转运表现。结果将通道的功能从一条固定孔道，扩展为蛋白与脂质膜共同决定的行为。",
            "这一方向延续的是选择性跨膜运输问题。蛋白的静态孔径、膜内运动和实际通水速率不是同一个指标，模拟预测仍需结构与输运实验检验。"
          ],

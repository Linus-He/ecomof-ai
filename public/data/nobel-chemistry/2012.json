      "researchCases": [
        {
          "id": "gpcr",
          "heading": "把受体激活过程分成连续结构状态",
          "organizationIds": [
            "stanford"
          ],
          "authors": "Makaía M. Papasergi-Scott、Guillermo Pérez-Hernández、Hossein Batebi 等",
          "paperTitle": "Time-resolved cryo-EM of G-protein activation by a GPCR",
          "journal": "Nature (2024)",
          "published": "2024",
          "doi": "10.1038/s41586-024-07153-1",
          "paperUrl": "https://doi.org/10.1038/s41586-024-07153-1",
          "paragraphs": [
            "斯坦福大学及合作者使用时间分辨冷冻电镜与分子动力学，追踪 GTP 结合后 G 蛋白构象变化及其脱离受体的过程。不同构象让核苷酸位点与受体接触界面的变化可以相互对照。",
            "这类研究把静态受体结构推进到激活路径，但结构快照与完整反应速率仍需区分。样品制备、构象分类和模拟起点都会影响可观察的状态。"
          ],

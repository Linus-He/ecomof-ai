      "researchCases": [
        {
          "id": "insulin",
          "heading": "胰岛素开始被设计成对葡萄糖浓度作出响应",
          "organizationIds": [
            "bristol"
          ],
          "authors": "Thomas Hoeg-Jensen、Thomas Kruse、Christian L. Brand 等",
          "paperTitle": "Glucose-sensitive insulin with attenuation of hypoglycaemia",
          "journal": "Nature (2024)",
          "published": "2024",
          "doi": "10.1038/s41586-024-08042-3",
          "paperUrl": "https://doi.org/10.1038/s41586-024-08042-3",
          "paragraphs": [
            "布里斯托大学与诺和诺德等合作者研究 NNC2215：将葡萄糖识别单元与胰岛素构建连接，使其活性随葡萄糖水平发生可逆改变。论文通过体外和动物实验检验这一分子开关。",
            "这一工作延续了序列、构象与激素活性的关系，同时增加对环境信号的响应设计。论文中的实验性胰岛素不能与常规临床胰岛素产品混同，也不能据此推断人体治疗结果。"
          ],
          "sources": [
            {
              "label": "论文 DOI",
              "url": "https://doi.org/10.1038/s41586-024-08042-3"
            },
            {
              "label": "原始研究与机构资料",
              "url": "https://www.bristol.ac.uk/chemistry/news/2024/gluhut.html"
            }
          ],
          "relatedCompanyIds": [
            "novo"
          ],
          "relation": "诺和诺德是这篇论文的研究参与方；公司已有胰岛素业务与该实验性葡萄糖响应分子的研究阶段分别列明。"
        },
        {
          "id": "sugars",
          "heading": "糖化学的自动化：合成之后还要完成纯化",
          "organizationIds": [
            "slu"
          ],
          "authors": "Gustavo A. Kashiwagi、Laura Petrosilli、Samira Escopy 等",
          "paperTitle": "HPLC‐Based Automated Synthesis and Purification of Carbohydrates",
          "journal": "Chemistry – A European Journal (2024)",
          "published": "2024",
          "doi": "10.1002/chem.202401214",
          "paperUrl": "https://doi.org/10.1002/chem.202401214",
          "paragraphs": [
            "圣路易斯大学及合作者把温度受控反应与 HPLC 操作连接起来，让保护基变换、糖苷键形成和纯化在同一套自动化流程中衔接。示例覆盖糖苷、寡糖、糖肽、糖脂及核苷。",
            "糖的连接位置和异头构型都影响产物身份。自动进样只能减少重复操作；每一阶段的选择性、保护基兼容性和分离结果仍要检验，不能仅凭分子量确认连接正确。"
          ],

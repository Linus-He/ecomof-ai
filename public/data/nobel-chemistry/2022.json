  "reading": {
    "title": "点击化学与生物正交化学",
    "summary": "点击化学与生物正交化学。使复杂环境中的选择性化学操作更可行。",
    "sections": [
      {
        "id": "background",
        "title": [
          "研究背景",
          "Background"
        ],
        "body": "复杂体系中需要可靠连接分子，又不能大范围扰动周围化学。"
      },
      {
        "id": "principle",
        "title": [
          "原理与机理",
          "Principles and mechanisms"
        ],
        "body": "叠氮—炔反应提供高选择性连接；应变促进反应可减少对活体不友好的铜条件。",
        "equation": "\\mathrm{R\\!\\!{-}N_3+HC{\\equiv}C\\!\\!{-}R'\\xrightarrow{Cu(I)}1,2,3\\!\\!{-}triazole}",
        "equationNote": "CuAAC 反应示意；无铜应变促进反应使用不同炔结构，不等同于此催化条件。",
        "supplementalEquations": []
      },
      {
        "id": "uses",
        "title": [
          "应用",
          "Applications"
        ],
        "body": "用于分子连接、糖链标记、材料和生物分析。"
      },
      {
        "id": "significance",
        "title": [
          "科学意义",
          "Significance"
        ],
        "body": "使复杂环境中的选择性化学操作更可行。"
      },
      {
        "id": "development",
        "title": [
          "研究与产业进展",
          "Research and industrial progress"
        ],
        "body": "点击化学把分子连接与可视化联系起来。自动化糖化学及低光照成像分别延伸材料制备和观察能力，不能据此替代生物正交性的实测。"
      }

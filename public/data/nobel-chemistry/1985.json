  "reading": {
    "title": "晶体结构的直接方法",
    "summary": "晶体结构的直接方法。使从衍射数据直接求结构更具普适性。",
    "sections": [
      {
        "id": "background",
        "title": [
          "研究背景",
          "Background"
        ],
        "body": "衍射测得强度，却缺少重建电子密度所需的相位。"
      },
      {
        "id": "principle",
        "title": [
          "原理与机理",
          "Principles and mechanisms"
        ],
        "body": "利用电子密度的物理约束和结构因子统计关系推定相位。",
        "equation": "\\rho(\\mathbf r)=\\frac1V\\sum_{\\mathbf h}F_{\\mathbf h}e^{-2\\pi i\\mathbf h\\cdot\\mathbf r}",
        "equationNote": "Fourier 重建关系；F 包含振幅和相位，强度数据不能直接给出全部相位。",
        "supplementalEquations": []
      },
      {
        "id": "uses",
        "title": [
          "应用",
          "Applications"
        ],
        "body": "用于晶体结构解析与小分子结构测定。"
      },
      {
        "id": "significance",
        "title": [
          "科学意义",
          "Significance"
        ],
        "body": "使从衍射数据直接求结构更具普适性。"
      },
      {
        "id": "development",
        "title": [
          "研究与产业进展",
          "Research and industrial progress"
        ],
        "body": "结构的直接方法改变了晶体结构求解。新型碳笼连接研究仍依靠晶体学确定几何，再将几何与光谱及分子识别对应起来。"
      }

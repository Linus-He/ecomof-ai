      "researchCases": [
        {
          "id": "cellfree",
          "heading": "把发酵中的一条通路搬出细胞",
          "organizationIds": [
            "shanghaitech",
            "stanford"
          ],
          "authors": "Wan-Qiu Liu、Xiangyang Ji、Fang Ba 等",
          "paperTitle": "Cell-free biosynthesis and engineering of ribosomally synthesized lanthipeptides",
          "journal": "Nature Communications (2024)",
          "published": "2024",
          "doi": "10.1038/s41467-024-48726-y",
          "paperUrl": "https://doi.org/10.1038/s41467-024-48726-y",
          "paragraphs": [
            "上海科技大学与斯坦福大学的 UniBioCat 平台，将无细胞表达、翻译后修饰和肽成熟步骤组合，用于合成及筛选羊毛硫肽类天然产物。开放反应体系使酶量和底物条件更容易单独调节。",
            "实验重点是绕开细胞毒性、表达和降解限制，同时保留产物活性测定。可在小体系中得到活性产物，不等于已经解决大规模生产的酶成本、供能与回收问题。"
          ],

  "reading": {
    "title": "无细胞发酵",
    "summary": "无细胞发酵。把生命过程转化为能够离体研究的化学过程。",
    "sections": [
      {
        "id": "background",
        "title": [
          "研究背景",
          "Background"
        ],
        "body": "发酵是否必须依赖完整活细胞，曾是生物化学的重要争论。"
      },
      {
        "id": "principle",
        "title": [
          "原理与机理",
          "Principles and mechanisms"
        ],
        "body": "酵母的无细胞提取液仍能发酵，说明催化能力可由可提取组分承担。",
        "equation": "\\mathrm{C_6H_{12}O_6\\rightarrow 2C_2H_5OH+2CO_2}",
        "equationNote": "这是酒精发酵的总物料式；内部包含多个酶促步骤。",
        "supplementalEquations": []
      },
      {
        "id": "uses",
        "title": [
          "应用",
          "Applications"
        ],
        "body": "用于理解发酵、生物催化与代谢反应。"
      },
      {
        "id": "significance",
        "title": [
          "科学意义",
          "Significance"
        ],
        "body": "把生命过程转化为能够离体研究的化学过程。"
      },
      {
        "id": "development",
        "title": [
          "研究与产业进展",
          "Research and industrial progress"
        ],
        "body": "无细胞发酵证明化学转化不必依赖完整细胞。无细胞表达平台进一步将通路中的表达、修饰和活性筛选组合起来。"
      }
    ],

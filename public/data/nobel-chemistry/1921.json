  "reading": {
    "title": "同位素与放射性元素",
    "summary": "同位素与放射性元素。重新定义元素身份，解释质量不同却化学相似的现象。",
    "sections": [
      {
        "id": "background",
        "title": [
          "研究背景",
          "Background"
        ],
        "body": "化学性质几乎相同的放射性物质，为什么仍具有不同质量和衰变规律？"
      },
      {
        "id": "principle",
        "title": [
          "原理与机理",
          "Principles and mechanisms"
        ],
        "body": "同位素有相同原子序数，却有不同核质量；化学身份与核性质可分开描述。",
        "equation": "A=Z+N",
        "equationNote": "A 为质量数、Z 为质子数、N 为中子数；这是现代核组成解释，不是摩尔原子量。",
        "supplementalEquations": []
      },
      {
        "id": "uses",
        "title": [
          "应用",
          "Applications"
        ],
        "body": "用于放射化学、同位素标记与核素鉴别。"
      },
      {
        "id": "significance",
        "title": [
          "科学意义",
          "Significance"
        ],
        "body": "重新定义元素身份，解释质量不同却化学相似的现象。"
      },
      {
        "id": "development",
        "title": [
          "研究与产业进展",
          "Research and industrial progress"
        ],
        "body": "同位素概念让元素身份与核素质量分开讨论。放射性金属结构和同位素定量分别展示这一认识在化学中的两种延伸。"
      }

  "reading": {
    "title": "超分辨率荧光显微术",
    "summary": "超分辨率荧光显微术。通过控制荧光状态突破传统衍射图像的分辨限制。",
    "sections": [
      {
        "id": "background",
        "title": [
          "研究背景",
          "Background"
        ],
        "body": "传统光学显微分辨率难以区分距离极近的分子。"
      },
      {
        "id": "principle",
        "title": [
          "原理与机理",
          "Principles and mechanisms"
        ],
        "body": "STED 控制发光区域，单分子定位方法在时间上分离信号并精确定位。",
        "equation": "d_{\\rm STED}\\approx\\frac{\\lambda}{2NA\\sqrt{1+I/I_s}}",
        "equationNote": "理想化 STED 分辨率关系；定位显微术采用不同统计模型，非共用此式。",
        "supplementalEquations": []
      },
      {
        "id": "uses",
        "title": [
          "应用",
          "Applications"
        ],
        "body": "用于细胞纳米结构、蛋白分布与分子动态成像。"
      },
      {
        "id": "significance",
        "title": [
          "科学意义",
          "Significance"
        ],
        "body": "通过控制荧光状态突破传统衍射图像的分辨限制。"
      },
      {
        "id": "development",
        "title": [
          "研究与产业进展",
          "Research and industrial progress"
